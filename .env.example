# Copy to .env.local and fill in. Every variable is validated at startup
# by config/env.ts; the server will not start with an invalid value.

# --- Public (inlined into the browser bundle; never put secrets here) ---
NEXT_PUBLIC_APP_NAME="Next.js Boilerplate"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Server only ---
# Optional. When set, the contact form POSTs submissions here as JSON.
# CONTACT_WEBHOOK_URL=https://example.com/webhooks/contact
